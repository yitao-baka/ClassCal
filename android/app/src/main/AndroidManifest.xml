<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 课前提醒 ============================================================ -->

    <!-- Android 13 起通知要运行时授权，13 之前声明了会被忽略。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 精确闹钟。本 App 是自装、不上应用商店，用 USE_EXACT_ALARM 最省事：
         安装时自动授予，用户不必去设置里开开关。31-32 的系统不认这个权限名，
         那一档由 SCHEDULE_EXACT_ALARM 兜着，所以两个都声明、给后者一个
         maxSdkVersion。即便如此运行时仍要查 canScheduleExactAlarms() 并保留
         不精确的降级路径 —— 用户能在系统设置里把精确闹钟收回，某些 ROM 也不认。 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- 闹钟到点时短暂唤醒设备。没有它，息屏久了闹钟会被推迟到下次亮屏。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 重启后把闹钟重新排上 —— 不排的话「重启一次，之后一周没提醒」。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 定位门控。ACCESS_BACKGROUND_LOCATION 要「始终允许」，Android 11 起只能
         由用户去系统设置里点，所以设置页会引导。
         required="false"：没有定位硬件的设备照样能装，只是门控不可用。 -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application
        android:label="classcal"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 闹钟到点 ======================================================== -->

        <!-- 「到点了」那条广播。只有我们自己的 AlarmManager 会发给它，
             所以不导出。 -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- 通知上那两个按钮（我已到教室 / 10 分钟后再提醒）。 -->
        <receiver
            android:name=".ReminderActionReceiver"
            android:exported="false" />

        <!-- 重启、App 升级、改时间改时区之后重排闹钟。
             exported 必须是 true：系统广播发给谁由系统决定，而不是由我们指定。
             这不构成漏洞 —— 这里只监听受保护的系统广播，第三方应用发不出这些
             action；而在接收器里也只会「按落盘的表重排一遍闹钟」。 -->
        <receiver
            android:name=".ReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 桌面小组件 ====================================================== -->

        <!-- 桌面上那张课表卡片。
             刻意不写 android:configure —— 配置全部在 App 的那个 Flutter 页里。
             理由是 MainActivity 同时是「App 本身」时，退出语义会冲突：配置流程
             要求用户返回时 setResult(RESULT_CANCELED) 然后 finish()，而
             launchMode="singleTop" + taskAffinity="" 会让启动器复用后台那个
             实例 —— 于是「取消配置」会把用户正在用的 App 一起关掉。 -->
        <receiver
            android:name=".ClasscalWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/classcal_widget_info" />
        </receiver>

        <!-- 小组件的边界刷新闹钟。只有我们自己的 AlarmManager 会发给它，
             所以不导出。 -->
        <receiver
            android:name=".WidgetTickReceiver"
            android:exported="false" />

        <!-- 重启 / 升级 / 改时间改时区之后重画卡片。
             和 ReminderBootReceiver 并列而不是合并：两者的触发集看着一样，
             做的事不一样（那边重排提醒闹钟，这边重画卡片），各自在结尾重新
             武装自己那条链。 -->
        <receiver
            android:name=".WidgetBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
