<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 桌面图标下面和系统设置里的名字。
         `application` 的 `android:label` 引用它，所以**小组件的 receiver 也继承**
         这个名字（它自己没写 label）—— 小组件选择器里显示的就是它。

         为什么不全小写：`classcal` 是一个包名式的标识，而这是给人看的产品名。
         注意**别改 `applicationId` 去凑这个名字** —— 那等于换了一个 App，
         手机上已有的课表数据会全部读不到（理由记在项目备忘里）。 -->
    <string name="app_name">ClassCal</string>

    <!-- 小组件选择器里那行小字。刻意不写「下节课 / 今日课程」——
         这个实例到底画什么由用户在 App 里选，选择器里说死哪一种反而是误导。 -->
    <string name="widget_description">桌面课表</string>
</resources>
